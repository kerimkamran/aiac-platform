 @import "tailwindcss";
 
+/* Vantage "Node Grid" design system (plan v2, section 4).
+   Colours come from Azerconnect Group's own assets: navy #133E72 and green
+   #356D1B. Every colour in the app comes from one of the tokens below; a
+   test (src/lib/no-raw-colours.test.ts) fails the build on hard-coded
+   Tailwind palette classes or hex values outside this file.
+
+   Themes: light is the default and the `.dark` class switches to dark
+   (set before first paint by src/app/layout.tsx). Canvases (white, cream,
+   grey) change only the page background in light mode; dark mode has one
+   canvas. The contrast tests in src/lib/contrast.test.ts read these blocks
+   directly, so the values here are the source of truth. */
+
 :root {
-  /* v4 "Field" design system -- deliberately plain, editorial, light-first.
-     Reaction to v3's "generic AI app" tells (purple gradients, squircles,
-     glassmorphism, wall-to-wall cards): near-white surfaces, hairline
-     dividers instead of boxed shadows, sharp minimal corners, and exactly
-     one accent color (clay/terracotta) used sparingly for the single most
-     important thing on a screen -- never as decoration, never repeated
-     across a whole page. Structure carries hierarchy, not color or shadow. */
+  /* Surfaces and text */
   --background: #ffffff;
   --surface: #ffffff;
-  --surface-sunken: #fafafa;
-  --foreground: #1a1a1a;
-  --muted: #6b6b6b;
-  --line: #ececec;
