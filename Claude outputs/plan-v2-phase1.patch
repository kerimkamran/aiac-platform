+export type CaseLibraryQuestionType = "mcq" | "text";
+
+export type GeneratedCase = {
+  title: string;
+  scenarioText: string;
+  questionStem: string;
+  questionType: CaseLibraryQuestionType;
+  options?: { text: string; correct?: boolean }[];
+  difficulty: "mid" | "high";
+  methodologyTag: MethodologyTag;
