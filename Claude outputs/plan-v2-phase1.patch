+export type MethodologyTag =
+  | "Hogan-style derailment"
+  | "Mettl-style SJT"
+  | "WTW/Saville-style situation"
+  | "Korn Ferry-style exercise"
+  | "McLean-style behavioral anchor"
+  | "Blended";
