# Supabase project credentials (Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Service-role key (Settings → API → service_role, "secret" section).
# Required for "Copy invite link" and any other Auth Admin API call.
# Server-only -- never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-SECRET-KEY

# Canonical site URL used to build invite/reset-password links.
# Set the same value as "Site URL" in Supabase Auth -> URL Configuration, and
# list <this URL>/invite/callback under Redirect URLs there.
# If unset, the production domain (VERCEL_PROJECT_PRODUCTION_URL) is used.
# See supabase/email-templates/README.md for the full email and link setup.
NEXT_PUBLIC_SITE_URL=https://YOUR-PRODUCTION-DOMAIN

# Secret for the daily deadline-reminder job (/api/cron/reminders, see
# vercel.json). Vercel Cron sends it as "Authorization: Bearer <value>".
# Without it the job refuses every request, so no reminders are sent.
CRON_SECRET=A-LONG-RANDOM-STRING

# Company mail server, for assignment and reminder emails sent by Vantage itself
# (optional; without it those arrive as in-app notifications only).
# Sign-in links are still sent by Supabase Auth, see supabase/email-templates.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Vantage <vantage@example.com>"
